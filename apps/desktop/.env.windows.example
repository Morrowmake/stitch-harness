# Copy to .env.windows (Git ignored). Use UTF-8 and quote secrets containing # or spaces.
# Credential file paths may be absolute or relative to apps/desktop. Values are not shell-expanded.
STITCH_DESKTOP_APP_ID=io.github.morrowmake.stitch

# Optional npm registry for the bundled Stitch runtime install; defaults to https://registry.npmjs.org/.
# A local mirror such as https://registry.npmmirror.com speeds up repeated local packages.
# STITCH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com

# Signing fields; unsigned (--unsigned) builds ignore them and may leave them empty.
STITCH_DESKTOP_WINDOWS_CER_FILE=
STITCH_DESKTOP_WINDOWS_SIGNTOOL=
STITCH_DESKTOP_WINDOWS_KEY_CONTAINER=
STITCH_DESKTOP_WINDOWS_TOKEN_PIN=

# Optional absolute, private local directory; defaults to %USERPROFILE%\.stitch-desktop-signing\signature-cache\v1.
# STITCH_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=C:\Users\build\.stitch-desktop-signing\signature-cache\v1

# Cache-hit restore and verification workers (1-8). Hardware signing remains serial.
STITCH_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4

# Workspace tarball workers; omit to use 4. Must be a positive integer.
# STITCH_DESKTOP_WINDOWS_PACK_CONCURRENCY=4

# Installer archive compression (0-9); lower values trade size for packaging time.
STITCH_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3
