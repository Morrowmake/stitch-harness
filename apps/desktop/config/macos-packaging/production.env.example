# Copy to production.env before selecting this preset.
STITCH_DESKTOP_APP_ID=io.github.morrowmake.stitch
STITCH_DESKTOP_MACOS_PACK_CONCURRENCY=4
STITCH_DESKTOP_MACOS_ZIP_COMPRESSION_LEVEL=3
STITCH_DESKTOP_MACOS_DOWNLOAD_PROXY=
STITCH_DESKTOP_MACOS_NOTARIZATION_PROXY=
# Optional absolute private directory; setup fills this in for machine presets. Omit to use checkout-local storage.
# STITCH_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=
