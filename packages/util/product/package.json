{
  "name": "@deepseek-ai/dsh-product",
  "description": "Zero-dependency, browser-safe product identity constants (name, CLI command, home dir, env prefix, repository URLs)",
  "version": "0.2.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Morrowmake/stitch-harness.git",
    "directory": "packages/util/product"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT"
}
